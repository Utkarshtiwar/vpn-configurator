<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background_dark">#0B1020</color>
    <color name="divider_color">#26324A</color>
    <color name="dot_neutral">#FFFFFF</color>
    <color name="on_surface_primary">#F5F7FF</color>
    <color name="on_surface_secondary">#98A2B8</color>
    <color name="primary">#5B7CFA</color>
    <color name="primary_variant">#4863D6</color>
    <color name="status_error">#FF5C6C</color>
    <color name="status_info">#4DB8FF</color>
    <color name="status_success">#35D07F</color>
    <color name="status_warning">#F5B942</color>
    <color name="surface_dark">#121A2B</color>
    <color name="surface_elevated">#182238</color>
    <dimen name="button_corner_radius">14dp</dimen>
    <dimen name="button_height">52dp</dimen>
    <dimen name="card_corner_radius">16dp</dimen>
    <dimen name="card_elevation">2dp</dimen>
    <dimen name="card_stroke_width">1dp</dimen>
    <dimen name="console_height">420dp</dimen>
    <dimen name="input_corner_radius">12dp</dimen>
    <dimen name="spacing_12">12dp</dimen>
    <dimen name="spacing_16">16dp</dimen>
    <dimen name="spacing_20">20dp</dimen>
    <dimen name="spacing_24">24dp</dimen>
    <dimen name="spacing_4">4dp</dimen>
    <dimen name="spacing_8">8dp</dimen>
    <dimen name="text_body_secondary">13sp</dimen>
    <dimen name="text_card_label">11sp</dimen>
    <dimen name="text_screen_subtitle">13sp</dimen>
    <dimen name="text_screen_title">22sp</dimen>
    <dimen name="text_section_heading">12sp</dimen>
    <dimen name="text_value_large">26sp</dimen>
    <dimen name="text_value_medium">16sp</dimen>
    <string name="app_name">VpnTestPOC</string>
    <style name="DashboardCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/spacing_4</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/divider_color</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>
    <style name="DashboardCardContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/spacing_12</item>
        <item name="android:minHeight">72dp</item>
    </style>
    <style name="DashboardCardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textSize">@dimen/text_card_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="DashboardCardSmall" parent="DashboardCard"/>
    <style name="DashboardCardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/on_surface_primary</item>
        <item name="android:textSize">@dimen/text_value_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="DashboardCardValueLarge" parent="DashboardCardValue">
        <item name="android:textSize">@dimen/text_value_large</item>
    </style>
    <style name="DestructiveActionButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">@color/status_error</item>
    </style>
    <style name="EyebrowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_section_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="FieldCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textSize">@dimen/text_body_secondary</item>
    </style>
    <style name="KvDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="dividerColor">@color/divider_color</item>
    </style>
    <style name="KvLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textSize">@dimen/text_body_secondary</item>
    </style>
    <style name="KvRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">@dimen/spacing_8</item>
        <item name="android:paddingBottom">@dimen/spacing_8</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="KvValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_primary</item>
        <item name="android:textSize">@dimen/text_body_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">middle</item>
    </style>
    <style name="PremiumCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/spacing_20</item>
        <item name="android:layout_marginEnd">@dimen/spacing_20</item>
        <item name="android:layout_marginTop">@dimen/spacing_12</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/divider_color</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>
    <style name="PremiumCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/spacing_16</item>
    </style>
    <style name="PrimaryActionButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">@color/primary</item>
    </style>
    <style name="ScreenSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textSize">@dimen/text_screen_subtitle</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="ScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_primary</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SecondaryActionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_marginTop">@dimen/spacing_12</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/divider_color</item>
    </style>
    <style name="SectionHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textSize">@dimen/text_section_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>