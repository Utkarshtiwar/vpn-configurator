<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Icon Container -->
    <LinearLayout
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_metric_icon">

        <ImageView
            android:id="@+id/ivEventIcon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvEventMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/status_info"
        tools:text="Packet captured -> Protocol: TCP, Source: 10.0.0.2, Destination: 8.8.8.8, Size: 60 bytes" />

    <TextView
        android:id="@+id/tvEventTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:textSize="10.5sp"
        android:textColor="@color/on_surface_muted"
        tools:text="14:02:31" />

</LinearLayout>